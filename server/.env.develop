# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://localhost:27017/expense-tracker

# Security (IMPORTANT: Change this to a random string!)
JWT_SECRET=your_super_secret_random_string_make_it_very_long_and_unique_12345
JWT_EXPIRES_IN=7d

# Cache and Queue Services
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Email Configuration (Optional - you can leave these for now)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Cors origin for frontend
CORS_ORIGIN=http://localhost:5173

DISABLE_RABBITMQ=true
